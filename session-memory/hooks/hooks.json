{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/load-memory.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "Loading session memory"
          }
        ]
      }
    ]
  }
}
